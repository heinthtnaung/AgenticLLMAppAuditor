# The local model server's settings. Copy to `.env` and change what you need;
# an environment variable of the same name wins over the file. Only these seven
# AUDITOR_* keys are read, and a misspelt one is refused.
#
# A council runs only with --council or --council-member: AUDITOR_MODEL is the
# model a measurement asks when it is not told one. The tests never read this
# file; the live test asks another model through COUNCIL_LIVE_MODEL.
AUDITOR_MODEL=qwen2.5:7b-instruct
# This machine, unless AUDITOR_REMOTE_SERVER below is yes. The old form ending in
# /api/generate is also read.
AUDITOR_SERVER_URL=http://127.0.0.1:11434
# Only `yes` lets AUDITOR_SERVER_URL name another machine, such as an Ollama server on
# your own network. Every advisory text the council reads is then sent to that machine:
# the members, the escalation model and the explainer all run there, and the record says
# they did not run locally. It is reached directly, never through a proxy. Unset or
# empty, a server elsewhere is refused.
# AUDITOR_REMOTE_SERVER=yes
AUDITOR_TIMEOUT_SECONDS=180
AUDITOR_CONTEXT_TOKENS=8192
# The models `audit --council` runs, comma-separated, e.g. gemma4:latest,qwen2.5:7b-instruct.
AUDITOR_COUNCIL_MEMBERS=
# One larger model on the same server, which a metric the council left contested or
# unresolved is sent to in both orders, e.g. qwen2.5:14b. Unset or empty: no escalation.
AUDITOR_ESCALATION_MODEL=
