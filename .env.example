# Copy this file to .env and edit it. .env is gitignored: it is your machine's
# settings, not the project's. Every value here is optional — the auditor uses
# these same defaults when no .env exists.
#
# A real environment variable always wins over a value set here.

# The local model used from Phase 3 onward.
AUDITOR_MODEL=qwen2.5-coder:7b-instruct

# The model that formats report.ai.html (a separate, optional AI-styled view;
# the authoritative report.html is deterministic and never model-generated).
AUDITOR_AI_REPORT_MODEL=gemma4:latest

# Where the local Ollama server is listening. This must stay a LOCAL address:
# the auditor is offline by design and must not call out to a remote service.
AUDITOR_SERVER_URL=http://localhost:11434/api/generate

# How long to wait for the model, in seconds.
AUDITOR_TIMEOUT_SECONDS=120

# The local embedding model the knowledge base is indexed and queried with.
# An index built with one model is unreadable by another, so the manifest
# records which one was used. Spell the tag: Ollama lists a pulled model as
# `name:latest`, and the manifest's digest pin is looked up by that exact
# string -- an untagged name here indexes fine and pins nothing.
AUDITOR_EMBED_MODEL=nomic-embed-text:latest

# Where the knowledge base lives: the upstream clones, the index and the
# manifest. A relative path is taken from the repository root.
AUDITOR_KNOWLEDGE_DIR=knowledge
